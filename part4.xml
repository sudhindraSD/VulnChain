        elif own_raw > 0:
            own_ratio = 1.0
        else:
            own_ratio = 0.0

        own_vpss = own_ratio * full_vpss
        result[pkg_id] = {
            "own_vpss": own_vpss,
            "own_ratio": own_ratio,
            "own_raw": own_raw,
            "direct_cves": cve_list,
