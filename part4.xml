def norm_feats(tensor, continuous_indices):
    norm_tensor = tensor.clone()
    for idx in continuous_indices:
        col = norm_tensor[:, idx]
        min_val = col.min()
        max_val = col.max()
        norm_tensor[:, idx] = (col - min_val) / (max_val - min_val) if max_val > min_val else 0.0
    return norm_tensor

