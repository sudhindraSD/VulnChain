    dates = []
    for cve_node in graph["nodes"]["CVE"]:
        ghsa_id = cve_node["id"]
        if ghsa_id in osv and osv[ghsa_id].get("published"):
            dates.append(osv[ghsa_id]["published"][:10])
    dates.sort()

    year_counts = defaultdict(int)
    for d in dates:
