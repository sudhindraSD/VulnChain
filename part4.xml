            "# lines 120-126, reverse pass via edge_index.flip(0) at lines 159-164) HAS these directions —\n",
            "# that is the architecture whose masked-edge sensitivity v1's primary gate actually measured\n",
            "# (0.6315 AUC). Restoring the 4 reverse directions restores direction parity and intervention\n",
            "# liveness. Nothing else changes (per-type conv implementation remains v2's GATConv per §6.1).\n",
            "FORWARD_EDGE_TYPES = [\n",
            "    ('Package', 'dependsOn', 'Package'),\n",
            "    ('Package', 'hasVulnerability', 'CVE'),\n",
            "    ('Package', 'maintainedBy', 'Author'),\n",
            "    ('CVE', 'introducedBy', 'Author'),\n",
            "]\n",
            "\n",
            "REVERSE_EDGE_TYPES = [\n",
            "    ('Package', 'rev_dependsOn', 'Package'),\n",
            "    ('CVE', 'rev_hasVulnerability', 'Package'),\n",
            "    ('Author', 'rev_maintainedBy', 'Package'),\n",
            "    ('Author', 'rev_introducedBy', 'CVE'),\n",
            "]\n",
            "\n",
            "def with_reverse_edges(edge_index_dict):\n",
            "    \"\"\"Extend an edge dict with flipped reverse edges for every canonical forward type\n",
            "    (mirrors HANLayer.forward's edge_index.flip(0) reverse pass, layers.py:159-164).\n",
            "    Reverse edges are DERIVED at call time, so any edge masking of hasVulnerability\n",
            "    (training-time dropout or the 50% masked evaluation) automatically removes the\n",
            "    corresponding reverse messages too.\"\"\"\n",
            "    full = dict(edge_index_dict)\n",
            "    for (src, rel, dst) in FORWARD_EDGE_TYPES:\n",
            "        fwd_key = (src, rel, dst)\n",
            "        if fwd_key in full:\n",
            "            full[(dst, 'rev_' + rel, src)] = full[fwd_key].flip(0)\n",
            "    return full\n",
            "\n",
            "class VulnGATv2(nn.Module):\n",
            "    def __init__(self, pkg_in_dim=10, cve_in_dim=769, author_in_dim=7, hidden_dim=128, heads=4):\n",
