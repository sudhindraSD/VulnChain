            "year_distribution": dict(sorted(year_counts.items())),
        }
    }
    with open(OUTPUT_REPORT, "w", encoding="utf-8") as f:
        json.dump(report, f, indent=2)
    print(f"[OK] Saved Part B refresh report to: {OUTPUT_REPORT}")


