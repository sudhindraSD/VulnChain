            "    cve_edge_key = ('Package', 'hasVulnerability', 'CVE')\n",
            "    if cve_edge_key in new_edges:\n",
            "        edges = new_edges[cve_edge_key]\n",
            "        mask = torch.rand(edges.size(1), device=edges.device) > p_mask\n",
            "        new_edges[cve_edge_key] = edges[:, mask]\n",
            "    return new_edges"
