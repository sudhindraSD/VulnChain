            "            ('Package', 'maintainedBy', 'Author'): GATConv((hidden_dim, hidden_dim), hidden_dim // heads, heads=heads, add_self_loops=False),\n",
            "            ('CVE', 'introducedBy', 'Author'): GATConv((hidden_dim, hidden_dim), hidden_dim // heads, heads=heads, add_self_loops=False),\n",
            "            ('Package', 'rev_dependsOn', 'Package'): GATConv(hidden_dim, hidden_dim // heads, heads=heads, add_self_loops=False),\n",
            "            ('CVE', 'rev_hasVulnerability', 'Package'): GATConv((hidden_dim, hidden_dim), hidden_dim // heads, heads=heads, add_self_loops=False),\n",
            "            ('Author', 'rev_maintainedBy', 'Package'): GATConv((hidden_dim, hidden_dim), hidden_dim // heads, heads=heads, add_self_loops=False),\n",
            "            ('Author', 'rev_introducedBy', 'CVE'): GATConv((hidden_dim, hidden_dim), hidden_dim // heads, heads=heads, add_self_loops=False),\n",
            "        }, aggr='sum')\n",
