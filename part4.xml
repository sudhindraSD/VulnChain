            "            'CVE': F.relu(self.cve_proj(x_dict['CVE'])),\n",
            "            'Author': F.relu(self.author_proj(x_dict['Author'])),\n",
            "        }\n",
            "        edge_dict_full = with_reverse_edges(edge_index_dict)  # [FIX A2]\n",
            "        h1 = self.conv1(h_dict, edge_dict_full)\n",
