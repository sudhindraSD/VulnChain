export default function SummaryBar({ summary, totalPackages }) {
  const notChecked = summary?.not_checked ?? 0;
  const reasons = summary?.not_checked_reasons
    ? Object.entries(summary.not_checked_reasons).map(([r, n]) => `${n} ${r}`).join(', ')
